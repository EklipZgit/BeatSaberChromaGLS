<bg>
  <modal id='ferro-settings-modal' show-event='show-ferro' hide-event='hide-ferro' click-off-closes='false' move-to-center='true' size-delta-x='110' size-delta-y='72'>
    <vertical pad='2' spacing='1' horizontal-fit='Unconstrained' vertical-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
      <text text='Ferrofluid (session only)' align='Center' font-size='5' preferred-height='8' />
      <horizontal spacing='4' preferred-height='8' min-height='8'>
        <button text='Cancel' on-click='ferro-cancel' />
        <button text='Reset' on-click='ferro-reset' />
        <button text='Save' on-click='ferro-save' hover-hint='Keep these values for this game session. Restarting restores the defaults.' />
      </horizontal>
      <scroll-view min-height='50' preferred-height='50' flexible-height='0'>
        <vertical spacing='5' preferred-width='96' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' child-control-height='true' child-expand-height='false' child-control-width='true' child-expand-width='true'>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Cube floor physics' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <bool-setting text='Floor assistance' value='ferrofluid-floor-assistance-enabled' apply-on-change='true' get-event='refresh-ferro' hover-hint='Automatic floor help: pose snap, face landing impulse, rocking damping, and extra floor brakes. Off keeps real collisions and friction but the cube may rock on landing.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Flat-face floor grip' value='ferrofluid-cube-floor-friction' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.5' increment='0.005' hover-hint='Cube floor grip while a face rests within 10 degrees of flat. Lower slides longer. Default 0.25; the previous owned-material slide matched 0.125.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Corner-top grip' value='ferrofluid-cube-corner-friction' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.05' increment='0.001' hover-hint='Corner contact grip while a tilted cube spins on a corner. Higher restores sideways steering but adds spin resistance. Default 0.01; previous 0.001.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Face landing impulse' value='ferrofluid-cube-face-landing-strength' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.05' hover-hint='Last-step angular softening when a tipping cube face lands. Default 0.5; previous 0.6. 0 disables only this landing assist.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Damping strength' value='ferrofluid-cube-face-damping-strength' apply-on-change='true' get-event='refresh-ferro' min='0' max='10' increment='0.05' hover-hint='Angular damping rate per second at the start angle, only while rotating away from flat. Default 1.2. Set 0 to disable.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Damping exponent' value='ferrofluid-cube-face-damping-exponent' apply-on-change='true' get-event='refresh-ferro' min='0' max='6' increment='0.05' hover-hint='How fast damping grows as the face nears flat. Default 2 quadruples the rate each time the angle halves.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Start angle' value='ferrofluid-cube-face-damping-start-angle' apply-on-change='true' get-event='refresh-ferro' min='0' max='30' increment='0.5' hover-hint='Maximum angle in degrees from flat where the extra damping applies, only while rotating away. Default 10 degrees. Set 0 to disable.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Visibility' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <bool-setting text='Show ferrofluid torus' value='ferrofluid-body-enabled' apply-on-change='true' get-event='refresh-ferro' hover-hint='Disable the complete ferrofluid renderer and all simulation passes.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <bool-setting text='Show ferrofluid spikes' value='ferrofluid-spikes-enabled' apply-on-change='true' get-event='refresh-ferro' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Base color' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Base red' value='ferrofluid-base-red' min='0' max='1' increment='0.005' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Base green' value='ferrofluid-base-green' min='0' max='1' increment='0.005' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Base blue' value='ferrofluid-base-blue' min='0' max='1' increment='0.005' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Ferrofluid exposure' value='ferrofluid-exposure' apply-on-change='true' get-event='refresh-ferro' min='0' max='2' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Ferrofluid emission' value='ferrofluid-emission-strength' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.2' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Reflections' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Surface reflectivity' value='ferrofluid-reflectivity' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' hover-hint='Master reflection strength. 0 leaves the base colour and optional thin film; source strengths multiply this. Default 0.21.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Room strength' value='ferrofluid-room-reflection-strength' min='0' max='4' increment='0.01' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Feet strength' value='ferrofluid-feet-reflection-strength' min='0' max='4' increment='0.01' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Parabola reflection strength' value='ferrofluid-parabola-reflection-strength' min='0' max='8' increment='0.01' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Parabola reflection saturation' value='ferrofluid-parabola-reflection-saturation' min='0' max='1' increment='0.01' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' hover-hint='1 preserves the saved light colour; lower values make only its reflection paler. Does not change or rebake the floor light.' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Thin film' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Thin film strength' value='ferrofluid-thin-film-strength' min='0' max='1' increment='0.01' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Thin Film LUT angle rate' value='ferrofluid-thin-film-angle-rate' min='0' max='4' increment='0.01' apply-on-change='true' get-event='refresh-ferro' preferred-height='7' min-height='7' font-size='3.5' font-size-min='2.5' font-size-max='3.5' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' hover-hint='Scales the thin-film LUT view-angle coordinate. 1 keeps the original traversal, lower values run it slower and higher values faster. Session-only: Reset or a restart restores 1.' />
            <slider-setting text='LUT table scale' value='ferrofluid-lut-scale' apply-on-change='true' get-event='refresh-ferro' min='0' max='4' increment='0.01' hover-hint='Scales normalized spike height before the thin-film LUT lookup. Default 3 compresses traversal into the first LUT rows.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='LUT table initial offset' value='ferrofluid-lut-offset' apply-on-change='true' get-event='refresh-ferro' min='-1' max='1' increment='0.01' hover-hint='Shifts the starting thin-film LUT row. Default 0.07 starts slightly above the source table edge.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Object shape' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Cube corner roundness' value='ferrofluid-cube-roundness' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' hover-hint='Blends the cube between sharp faces and a fully rounded sphere. Default 0.2.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Sphere chart yaw' value='ferrofluid-sphere-chart-yaw' apply-on-change='true' get-event='refresh-ferro' min='0' max='90' increment='1' hover-hint='Rotates the sphere spike chart around its up axis in degrees. Default 0 keeps crease arcs off the player-facing side.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Sphere bulge scale' value='ferrofluid-sphere-bulge-scale' apply-on-change='true' get-event='refresh-ferro' min='0' max='1.5' increment='0.01' hover-hint='Scales only the sphere reactive support bulge. Default 0.6 bakes the requested 40 percent reduction.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Spike shape' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Spike tallness' value='ferrofluid-spike-height-scale' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='4' increment='0.05' hover-hint='Multiplies rendered spike extrusion without changing magnetic Maximum height. Default 0.9.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike mound curvature' value='ferrofluid-spike-mound-curvature' apply-on-change='true' get-event='refresh-ferro' min='1' max='4' increment='0.05' hover-hint='Rounds the overall height envelope across neighboring spike tips. Does not reshape individual spikes or change their tilt. 1 keeps the original height response; higher values fill out the mound. Default 1.4.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Primitive tip cap rounding' value='ferrofluid-primitive-tip-cap-rounding' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' hover-hint='Scales the fixed rounded cap on cube and sphere spike tips. 0 removes the cap and its apex plateau for sharper points; 1 applies the full cap. Default 0.81.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Primitive tip roundness' value='ferrofluid-primitive-tip-roundness' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' hover-hint='Blends primitive tips between a sharp cone and a rounded dome, including magnet-driven spikes. Default 0 adds no dome blend.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike base size' value='ferrofluid-spike-base-size' apply-on-change='true' get-event='refresh-ferro' min='0.5' max='8' increment='0.05' hover-hint='Widens each spike footprint. Default 5.3.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Primitive spike size' value='ferrofluid-primitive-spike-size' apply-on-change='true' get-event='refresh-ferro' min='0.3' max='2' increment='0.05' hover-hint='Scales each primitive cone footprint relative to its cell. Default 0.35.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike base cutoff' value='ferrofluid-spike-base-cutoff' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.3' increment='0.001' hover-hint='Suppresses the membrane exactly at spike-cell boundaries while preserving apex height. Default 0.15.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Spike density' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Spike density' value='ferrofluid-spike-density' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='1.5' increment='0.05' hover-hint='Scales both particle lattice axes and resets the fluid field. Default 0.45 uses the captured 32-by-8 lattice.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Cube spike density' value='ferrofluid-cube-spike-density' apply-on-change='true' get-event='refresh-ferro' min='0.5' max='3' increment='0.05' hover-hint='Multiplies the cube lattice axis on top of shared density. Default 1.6 bakes the requested 60 percent tighter packing.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Sphere spike density' value='ferrofluid-sphere-spike-density' apply-on-change='true' get-event='refresh-ferro' min='0.5' max='3' increment='0.05' hover-hint='Multiplies the sphere lattice axis on top of shared density. Default 1.25 bakes the requested 25 percent tighter packing.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Magnet height and bulge' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Maximum height' value='maximum-height' apply-on-change='true' get-event='refresh-ferro' min='0.2' max='3' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Height gain' value='height-gain' apply-on-change='true' get-event='refresh-ferro' min='0' max='4' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Height falloff exponent' value='height-falloff-exponent' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='8' increment='0.05' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Magnet peak width' value='peak-width' apply-on-change='true' get-event='refresh-ferro' min='0.03' max='1' increment='0.01' hover-hint='Width of the magnetic response across neighboring spikes, not the rounding of an individual tip. The height dead zone can mask changes near the center.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Height amount cap' value='magnet-height-strength-cap' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' hover-hint='Caps the magnetic height contribution near the torus without capping tilt. Default 0.66.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Height dead zone' value='magnet-height-dead-zone-radius' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.5' increment='0.005' hover-hint='Source-space radius that uses the full capped magnetic height. Default 0.13 creates a small center plateau.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Bulge height' value='bulge-height' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.2' increment='0.005' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Bulge radius' value='bulge-radius' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='3.2' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike height radius' value='ferrofluid-spike-height-radius' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='3.2' increment='0.01' hover-hint='Radius for magnetic height gain and back flatten on primitives, independent of the supporting bulge. Default 0.31 preserves the current height response.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Magnet tilt' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Maximum tilt' value='maximum-tilt-degrees' apply-on-change='true' get-event='refresh-ferro' min='0' max='85' increment='1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Tilt peak radius' value='tilt-peak-radius-multiplier' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='1.5' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Tilt return radius' value='tilt-return-radius-multiplier' apply-on-change='true' get-event='refresh-ferro' min='0.2' max='3' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Tilt rise exponent' value='tilt-rise-exponent' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='6' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Tilt return exponent' value='tilt-return-exponent' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='6' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Inner corner separation' value='inner-corner-fan' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike tilt radius' value='ferrofluid-spike-tilt-radius' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='3.2' increment='0.01' hover-hint='Radius for outward lean and return plus dual-magnet direction weights on primitives, independent of the bulge. Default 0.73 restores the wider lean range.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Surface motion' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Magnet radius' value='magnet-radius' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='8' increment='0.1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Maximum slide' value='magnet-maximum-slide' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='8' increment='0.1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Slide fraction' value='magnet-slide-fraction' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Slide falloff' value='magnet-slide-falloff-exponent' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='6' increment='0.05' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Elasticity' value='magnet-elasticity' apply-on-change='true' get-event='refresh-ferro' min='4' max='160' increment='1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Damping' value='magnet-damping' apply-on-change='true' get-event='refresh-ferro' min='2' max='30' increment='0.1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Magnet forward distance' value='magnet-forward-distance' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.6' increment='0.01' hover-hint='Source-space gap between the magnetic field point and the cube/sphere surface; smaller values pull the response tighter to the surface. Default 0.09 from the confirmed session.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Home return' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Home spring strength gain' value='ferrofluid-home-elasticity-gain' apply-on-change='true' get-event='refresh-ferro' min='0' max='2' increment='0.01' hover-hint='Scales the pull toward the immutable home. Default 0.1. Session only, reset on restart.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Home quadratic ramp (log2)' value='ferrofluid-home-quadratic-power' apply-on-change='true' get-event='refresh-ferro' min='0' max='16' increment='0.25' hover-hint='Each step of 1 doubles the extra stiffness. Lower values allow more slip. Default 8.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Home soft range fraction' value='ferrofluid-home-soft-range' apply-on-change='true' get-event='refresh-ferro' min='0' max='0.9' increment='0.01' hover-hint='Fraction of the travel bound where the quadratic ramp starts; 0.04 is 2% face width at the default limit.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Home travel limit' value='ferrofluid-home-travel-limit' apply-on-change='true' get-event='refresh-ferro' min='0.05' max='0.5' increment='0.01' hover-hint='Hard home-neighborhood bound in face widths; 0.5 is half the cube face.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Surface damping gain' value='ferrofluid-home-damping-gain' apply-on-change='true' get-event='refresh-ferro' min='0' max='4' increment='0.01' hover-hint='Gain on the existing surface damping; 0 leaves free inertia, 1 is current, 4 is stronger. Session only.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Flattening' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Back flatten' value='back-height-loss' apply-on-change='true' get-event='refresh-ferro' min='0' max='4' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Back flatten falloff' value='back-height-falloff-exponent' apply-on-change='true' get-event='refresh-ferro' min='0.05' max='8' increment='0.05' hover-hint='Controls back-facing flattening across the enlarged magnetic radius. Default 2 uses the captured 1.37.1 profile.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Primitive flatten radius' value='ferrofluid-primitive-flatten-radius' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='2' increment='0.01' hover-hint='Fraction of the magnetic bulge radius over which away-facing primitive spikes flatten. Default 0.55.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Primitive flatten exponent' value='ferrofluid-primitive-flatten-exponent' apply-on-change='true' get-event='refresh-ferro' min='0.25' max='6' increment='0.05' hover-hint='Shapes how away-facing spikes unflatten across the flatten radius; higher keeps them flattened longer then releases sharply. Default 2 matches the previous fixed curve.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Primitive global flatten' value='ferrofluid-primitive-global-flatten' apply-on-change='true' get-event='refresh-ferro' min='0' max='1' increment='0.01' hover-hint='Flattens every spike slightly as the main reactive spot grows taller so it stands out against the settled surface. Default 0.3.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
          <vertical spacing='1.5' vertical-fit='PreferredSize' horizontal-fit='Unconstrained' child-control-width='true' child-expand-width='true' child-control-height='true' child-expand-height='false'>
            <text text='Fluid simulation' font-size='4.5' bold='true' preferred-height='9' min-height='9' align='Left'/>
            <slider-setting text='Mass / pressure' value='particle-mass' apply-on-change='true' get-event='refresh-ferro' min='0.01' max='5' increment='0.01' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Density threshold' value='rest-density' apply-on-change='true' get-event='refresh-ferro' min='0.1' max='5' increment='0.05' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Gas constant' value='gas-constant' apply-on-change='true' get-event='refresh-ferro' min='10' max='500' increment='1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Viscosity' value='viscosity' apply-on-change='true' get-event='refresh-ferro' min='1' max='20' increment='0.1' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Extra simulation steps' value='simulation-steps' apply-on-change='true' get-event='refresh-ferro' min='0' max='6' increment='1' hover-hint='Additional pressure/force/integration passes per 180 Hz tick. Default 2 means the base pass plus two extra passes.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike spring strength' value='ferrofluid-spike-spring-strength' apply-on-change='true' get-event='refresh-ferro' min='1' max='800' increment='5' hover-hint='Spring pull accelerating actual spike height toward the magnet target. Higher tracks the magnet faster; lower lags further behind.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
            <slider-setting text='Spike spring damping' value='ferrofluid-spike-spring-damping' apply-on-change='true' get-event='refresh-ferro' min='0' max='80' increment='0.5' hover-hint='Velocity loss that settles the spike spring. Below the critical value spikes overshoot and wobble; above it they approach without overshoot.' font-size='3.5' font-size-min='2.5' font-size-max='3.5' preferred-height='7' min-height='7' word-wrapping='false' overflow-mode='Ellipsis' enable-auto-sizing='true' />
          </vertical>
        </vertical>
      </scroll-view>
    </vertical>
  </modal>
</bg>